# Django backend configuration for the FSKTM PG Office API.
#
# Copy this file to ".env" (in this backend/ folder) and fill in your values:
#     PowerShell:  Copy-Item .env.example .env
#     bash:        cp .env.example .env
#
# ".env" is gitignored. Never commit real secrets.

# Django secret key. Production startup requires a random value with at least
# 50 characters and 5 unique characters. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

DJANGO_DEBUG=True
# Production startup requires explicit hosts and rejects wildcards.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Development-only demo fixtures. Keep disabled and passwords blank in tracked
# configuration. Put local values in backend/.env only.
ENABLE_DEMO_ACCOUNTS=False
DEMO_ADMIN_PASSWORD=
DEMO_COORDINATOR_PASSWORD=
DEMO_LECTURER_PASSWORD=
DEMO_STUDENT_PASSWORD=
# Optional JSON object used once to preserve local user IDs when renaming fixtures.
DEMO_LEGACY_EMAIL_MAP=

# Same-origin production example: https://portal.example.test
# Where the React frontend runs. Used to build the activation and password-reset links.
FRONTEND_URL=http://localhost:3000

# Browsers allowed to call the API directly (CORS). Production startup requires
# at least one explicit HTTPS origin and rejects HTTP or malformed origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production HTTPS controls. Begin HSTS at one hour without subdomains/preload.
# Increase to 31536000 and enable the other flags only after HTTPS is verified
# for every subdomain.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Enable only behind a trusted reverse proxy that strips untrusted incoming
# X-Forwarded-Proto headers before setting its own value. The tracked Nginx
# template meets this requirement.
DJANGO_TRUST_X_FORWARDED_PROTO=False

# Cache: blank selects locmem for DEBUG=True and database for DEBUG=False.
# Production accepts only database, shared by all workers on the same PostgreSQL
# database. Run `python manage.py createcachetable` before serving requests.
DJANGO_CACHE_BACKEND=

# Public authentication endpoint throttles.
AUTH_LOGIN_THROTTLE_RATE=10/minute
AUTH_PASSWORD_RESET_THROTTLE_RATE=5/hour
AUTH_PASSWORD_RESET_CONFIRM_THROTTLE_RATE=10/hour
AUTH_PASSWORD_LINK_CHECK_THROTTLE_RATE=30/hour
AUTH_CHANGE_PASSWORD_THROTTLE_RATE=10/hour
REGISTRY_ACCESS_LINK_THROTTLE_RATE=3/hour
REGISTRY_BATCH_INVITE_THROTTLE_RATE=3/hour
# A bulk import fills a missing student email as <Student ID>@<this domain>.
REGISTRY_STUDENT_EMAIL_DOMAIN=siswa.um.edu.my
# Keep zero unless the exact number of trusted reverse proxies is known.
# A deployment with only the tracked Nginx proxy uses 1. Otherwise configure
# the exact number of trusted reverse proxies.
DRF_NUM_PROXIES=0

# JWT session lifetimes. Access tokens remain in frontend memory; rotating
# refresh tokens are stored only in an HttpOnly /api/auth/ cookie.
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# Sign-ins without "Remember me" end this many hours after their last use.
JWT_SESSION_REFRESH_HOURS=12

# PostgreSQL (same database you set up for the project)
# NOTE: if you have more than one PostgreSQL version installed, the second one
# may listen on 5433 instead of 5432, so check yours.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=fsktm_pg_office

# Email (password-reset link)
# Leave EMAIL_HOST_USER / EMAIL_HOST_PASSWORD BLANK to print the reset email
# (with the link) to the runserver console instead of sending it.
#
# To send real Gmail: enable 2-Step Verification on the Google account, then
# create an "App Password" (Google Account → Security → 2-Step Verification →
# App passwords) and paste the 16-character value below (no spaces).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FSKTM PG Office <no-reply@fsktm.edu.my>

# AI replies for the FAQ chatbot (optional). Leave the key blank and the chatbot
# answers from the search alone. Create a key at https://openrouter.ai/settings/keys
# and keep it here only, never in a VITE_ variable. Only ":free" models are ever called.
# The office turns the replies on in FAQ Chatbot > Settings.
OPENROUTER_API_KEY=
FAQ_AI_MODELS=recursive/flint-v1.0:free,dots-studio/dots-3-note-preview:free
FAQ_AI_TIMEOUT_SECONDS=20
FAQ_AI_DAILY_LIMIT=45
FAQ_AI_STUDENT_DAILY_LIMIT=10
